{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dievas-documentation",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "docs.dievas.serticode.com",
      "custom_domain": true
    }
  ]
}
