{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dievas: Example App",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/packages/dievas/example",
            "program": "${workspaceFolder}/packages/dievas/example/lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug"
        },
        {
            "name": "Dievas: Widgetbook",
            "type": "dart",
            "request": "launch",
            "cwd": "${workspaceFolder}/packages/dievas_gallery",
            "program": "${workspaceFolder}/packages/dievas_gallery/lib/main.dart",
            "deviceId": "chrome",
            "flutterMode": "debug"
        },
        {
            "name": "Dievas: Landing Page",
            "type": "node-terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}/landing",
            "command": "dart pub global run jaspr_cli:jaspr serve --launch-in-chrome"
        }
    ]
}
